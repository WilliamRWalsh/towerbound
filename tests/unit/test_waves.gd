extends GutTest
## The woodland level's wave data, generated by tools/make_waves.py.

const WOODLAND := preload("res://data/levels/woodland.tres")
const SKELETON := preload("res://scenes/enemies/skeleton.tscn")
const GOBLIN := preload("res://scenes/enemies/goblin.tscn")


func test_ten_waves() -> void:
	assert_eq(WOODLAND.waves.size(), 10)


func test_enemy_counts_per_wave() -> void:
	var counts: Array[int] = []
	var total := 0
	for wave in WOODLAND.waves:
		counts.append(wave.enemy_count())
		total += wave.enemy_count()
	assert_eq(counts, [16, 22, 30, 36, 43, 51, 59, 68, 77, 89] as Array[int])
	assert_eq(total, 491)


func test_mana_reward_per_wave() -> void:
	var rewards: Array[float] = []
	for wave in WOODLAND.waves:
		rewards.append(wave.mana_reward)
	assert_eq(rewards, [3.0, 3.0, 4.0, 4.0, 5.0, 5.0, 6.0, 6.0, 7.0, 7.0] as Array[float])


func test_reward_weight_sums_the_enemies() -> void:
	assert_almost_eq(WOODLAND.waves[0].reward_weight(), 16.0, 0.001, "11 skeletons, 5 goblins")


func test_wave_one_sends_skeletons_and_goblins() -> void:
	var counts: Array = WOODLAND.waves[0].enemy_counts()
	assert_eq(counts.size(), 2)
	assert_eq(counts[0], [SKELETON, 11])
	assert_eq(counts[1], [GOBLIN, 5])


func test_final_wave_sends_all_five_types() -> void:
	assert_eq(WOODLAND.waves[9].enemy_counts().size(), 5)


func test_announcements() -> void:
	assert_eq(WOODLAND.waves[0].announcement_for(1), "Wave 1 Incoming")
	assert_eq(WOODLAND.waves[9].announcement_for(10), "Final Wave")


func test_level_starting_state() -> void:
	assert_eq(WOODLAND.deck.size(), 15)
	assert_eq(WOODLAND.hand_size, 4)
	assert_eq(WOODLAND.starting_mana, 6.0)
	assert_eq(WOODLAND.max_mana, 10.0)
	assert_eq(WOODLAND.castle_health, 20)
	assert_eq(WOODLAND.prepare_time, 7.0)
